# Copy to .env and fill in. .env is gitignored and must never be committed.
# `make demo` requires NONE of these — it runs entirely from fixtures/llm_cache/.

# Razorpay — TEST MODE ONLY. Live credentials must never be placed here (NFR-7).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# LLM providers. Groq is primary, OpenRouter is the failover.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Voice (Sarvam) — Day 7.
SARVAM_API_KEY=

# Determinism.
PRAMAAN_SEED=42

# shadow = log the action, do not execute it. live = execute against Razorpay TEST mode.
PRAMAAN_MODE=shadow

# 1 = never make a network LLM call; a cache miss is a hard error. Set by `make demo`.
PRAMAAN_LLM_OFFLINE=0
